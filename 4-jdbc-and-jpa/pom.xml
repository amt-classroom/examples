<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.heigvd.amt</groupId>
        <artifactId>amt-exemples</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>4-jdbc-and-jpa</artifactId>
    <name>JDBC et JPA</name>
    <description>
        JDBC et JPA sur une vraie base PostgreSQL : pilotes, connexions et pool avec JDBC,
        puis entités, contexte de persistance, requêtes et chargement avec JPA.
    </description>

    <dependencies>
        <!-- Les entités ne voient que l'API, comme le code JDBC ne voit que java.sql. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Les annotations de conteneur de ConcertService. Aucun conteneur ne tourne ici : les
             tests injectent l'EntityManager et ouvrent la transaction eux-mêmes. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Les implémentations : le fournisseur JPA, le pilote JDBC et le pool. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Un second pilote : le même code JDBC tourne sur SQLite. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PostgreSQL dans un conteneur, démarré par les tests. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Génère Concert_ et Stage_, le métamodèle des requêtes Criteria. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.hibernate.orm</groupId>
                            <artifactId>hibernate-jpamodelgen</artifactId>
                            <version>${hibernate.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs combine.children="append">
                        <!-- Le processeur lit @Entity sans la réclamer, ce que javac signalerait. -->
                        <arg>-Xlint:-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Le SQL de hibernate.show_sql, une classe de test par fichier :
                         target/surefire-reports/<classe>-output.txt. -->
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    <!-- Le pilote SQLite charge une bibliothèque native, que le JDK signale sinon. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
