<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <!-- L'unité de l'application : Narayana ouvre et termine les transactions, l'EntityManager
         injecté par @PersistenceContext les rejoint. Les réglages de Hibernate sont dans
         microprofile-config.properties. -->
    <persistence-unit name="ticketing" transaction-type="JTA">
        <jta-data-source>ticketing</jta-data-source>
        <class>ch.heigvd.amt.transactions.TicketStock</class>
        <class>ch.heigvd.amt.validation.Reservation</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
