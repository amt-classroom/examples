<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.heigvd.amt</groupId>
        <artifactId>amt-exemples</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>8-presentation-serialization-communication</artifactId>
    <name>Présentation, sérialisation et communication</name>
    <description>
        Des exemples exécutables sur la couche présentation d'une application Helidon MP (DTO,
        mapper, ressource Jakarta REST, erreurs, idempotence, If-Match, contrat OpenAPI) et sur
        quatre formats de sérialisation : Java, XML avec ses parseurs, JAXB, XSD et XJC, JSON,
        et Protobuf avec gRPC.
    </description>

    <dependencies>
        <!-- Le serveur, CDI, Jakarta REST (Jersey) et MicroProfile Config. -->
        <dependency>
            <groupId>io.helidon.microprofile.bundles</groupId>
            <artifactId>helidon-microprofile-core</artifactId>
        </dependency>
        <!-- @Valid sur le corps d'une requête. -->
        <dependency>
            <groupId>io.helidon.microprofile.bean-validation</groupId>
            <artifactId>helidon-microprofile-bean-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Le contrat OpenAPI, généré depuis les ressources et servi sur /openapi. -->
        <dependency>
            <groupId>io.helidon.microprofile.openapi</groupId>
            <artifactId>helidon-microprofile-openapi</artifactId>
        </dependency>

        <!-- JSON : Jackson, branché sur Jersey, et son module pour java.time. -->
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-json-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- XML : JAXB, branché sur Jersey. -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-jaxb</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Protobuf, et gRPC dans Helidon. -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.microprofile.grpc</groupId>
            <artifactId>helidon-microprofile-grpc-server</artifactId>
        </dependency>

        <dependency>
            <groupId>io.helidon.logging</groupId>
            <artifactId>helidon-logging-jul</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- @HelidonTest : le serveur démarre pour la classe de test. -->
        <dependency>
            <groupId>io.helidon.microprofile.testing</groupId>
            <artifactId>helidon-microprofile-testing-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Le client gRPC des tests. -->
        <dependency>
            <groupId>io.helidon.webclient</groupId>
            <artifactId>helidon-webclient-grpc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <!-- Donne os.detected.classifier, pour télécharger le protoc de cette machine. -->
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <!-- L'index des classes, où Helidon lit les champs des DTO pour décrire l'API. -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                XJC génère les classes JAXB de src/main/resources/schema, en deux fois : le
                programme du festival, puis la déclaration d'impôt eCH-0119 et les schémas eCH
                qu'elle importe, trouvés par le catalogue plutôt que sur le réseau. Chaque
                exécution a son dossier : XJC vide le sien avant d'écrire.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>programme</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/resources/schema/programme.xsd</source>
                            </sources>
                            <packageName>ch.heigvd.amt.xjc.generated</packageName>
                            <outputDirectory>${project.build.directory}/generated-sources/jaxb</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>ech</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/resources/schema/ech/eCH-0119-4-0-0.xsd</source>
                            </sources>
                            <catalog>src/main/resources/schema/ech/catalog.xml</catalog>
                            <outputDirectory>${project.build.directory}/generated-sources/jaxb-ech</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- protoc génère les messages de src/main/proto. -->
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <!-- Des classes de Helidon portent des annotations OSGi absentes du
                             classpath, ce que javac signalerait. -->
                        <arg>-Xlint:-classfile</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Ce que chaque classe de test écrit : target/surefire-reports/<classe>-output.txt. -->
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    <!-- Une JVM par classe de test : une fois démarré, Helidon refuse toute
                         désérialisation Java dans sa JVM, ce qui toucherait les tests sans serveur. -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
