<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="programme">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="concert" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="artist" type="xs:string"/>
              <xs:element name="stage" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:long" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="year" type="xs:int" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
