<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.heigvd.amt</groupId>
        <artifactId>amt-exemples</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tika-and-poi</artifactId>
    <name>Apache Tika et Apache POI</name>
    <description>
        Un rapport PDF qui contient des tableaux, lu avec Apache Tika et réécrit en classeur
        Excel avec Apache POI.
    </description>

    <dependencies>
        <!-- Tika : l'API commune, puis le seul parseur dont l'exemple a besoin. -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-pdf-module</artifactId>
        </dependency>
        <!-- POI : le format .xlsx. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <!-- Tika et POI écrivent leurs journaux par SLF4J et Log4j : les deux vont sur la console. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-to-slf4j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lance Main avec ses dépendances : ../mvnw compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>ch.heigvd.amt.tables.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
